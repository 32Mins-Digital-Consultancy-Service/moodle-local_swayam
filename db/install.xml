<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/swayam/db" VERSION="20261118" COMMENT="Swayam Plus Integration"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
  <TABLES>
    <TABLE NAME="local_swayam_enrolmap" COMMENT="Maps Moodle user+course to Swayam Plus enrollmentId">
      <FIELDS>
        <FIELD NAME="id"           TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid"       TYPE="int"  LENGTH="10" NOTNULL="true" COMMENT="mdl_user.id"/>
        <FIELD NAME="courseid"     TYPE="int"  LENGTH="10" NOTNULL="true" COMMENT="mdl_course.id"/>
        <FIELD NAME="enrollmentid" TYPE="char" LENGTH="36" NOTNULL="true" COMMENT="Swayam Plus enrollment UUID"/>
        <FIELD NAME="swayamsub"    TYPE="char" LENGTH="36" NOTNULL="true" COMMENT="Swayam Plus OIDC sub UUID"/>
        <FIELD NAME="status"       TYPE="char" LENGTH="30" NOTNULL="true" DEFAULT="ACCESS_PROVISIONED" COMMENT="Swayam Plus enrollment status"/>
        <FIELD NAME="timecreated"  TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="completionsent"     TYPE="int" LENGTH="1"  NOTNULL="true" DEFAULT="0" COMMENT="1 = /completion accepted by Swayam Plus (HTTP 204)"/>
        <FIELD NAME="timecompletionsent" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="When /completion was accepted"/>
        <FIELD NAME="completionattempts" TYPE="int" LENGTH="5"  NOTNULL="true" DEFAULT="0" COMMENT="Number of /completion attempts"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="userid_courseid" UNIQUE="true"  FIELDS="userid, courseid"/>
        <INDEX NAME="userid"          UNIQUE="false" FIELDS="userid"/>
        <INDEX NAME="enrollmentid"    UNIQUE="true"  FIELDS="enrollmentid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_swayam_entitle" COMMENT="Swayam Plus enrollments received by webhook: entitlement + last applied sequence">
      <FIELDS>
        <FIELD NAME="id"              TYPE="int"  LENGTH="10"  NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="enrollmentid"    TYPE="char" LENGTH="36"  NOTNULL="true" COMMENT="Swayam Plus enrollment UUID"/>
        <FIELD NAME="swayamsub"       TYPE="char" LENGTH="36"  NOTNULL="true" COMMENT="Swayam Plus learner ID (OIDC sub)"/>
        <FIELD NAME="partnercourseid" TYPE="char" LENGTH="100" NOTNULL="true" COMMENT="Matches mdl_course.idnumber"/>
        <FIELD NAME="status"          TYPE="char" LENGTH="30"  NOTNULL="true" DEFAULT="ACCESS_PROVISIONED" COMMENT="Status after the last applied event"/>
        <FIELD NAME="reason"          TYPE="char" LENGTH="30"  NOTNULL="true" COMMENT="Revocation reason, if revoked"/>
        <FIELD NAME="sequence"        TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0" COMMENT="Highest event sequence applied"/>
        <FIELD NAME="sandbox"         TYPE="int"  LENGTH="1"   NOTNULL="true" DEFAULT="0" COMMENT="1 = Test drive enrollment"/>
        <FIELD NAME="timecreated"     TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified"    TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="enrollmentid" UNIQUE="true"  FIELDS="enrollmentid"/>
        <INDEX NAME="swayamsub"    UNIQUE="false" FIELDS="swayamsub"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_swayam_webhook" COMMENT="Webhook deliveries already processed (duplicate detection, kept 30 days)">
      <FIELDS>
        <FIELD NAME="id"           TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="deliveryid"   TYPE="char" LENGTH="64" NOTNULL="true" COMMENT="X-Swayam-Delivery"/>
        <FIELD NAME="eventtype"    TYPE="char" LENGTH="40" NOTNULL="true"/>
        <FIELD NAME="enrollmentid" TYPE="char" LENGTH="36" NOTNULL="true"/>
        <FIELD NAME="sequence"     TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="sandbox"      TYPE="int"  LENGTH="1"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="outcome"      TYPE="char" LENGTH="30" NOTNULL="true" COMMENT="What the plugin did with it"/>
        <FIELD NAME="timecreated"  TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="deliveryid"  UNIQUE="true"  FIELDS="deliveryid"/>
        <INDEX NAME="timecreated" UNIQUE="false" FIELDS="timecreated"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_swayam_log" COMMENT="Integration log (IDs and status codes only), deleted after the retention period">
      <FIELDS>
        <FIELD NAME="id"          TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="loglevel"    TYPE="char" LENGTH="10" NOTNULL="true" COMMENT="INFO, SUCCESS or ERROR"/>
        <FIELD NAME="event"       TYPE="char" LENGTH="64" NOTNULL="true" COMMENT="Event code"/>
        <FIELD NAME="userid"      TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="Moodle user the entry is about, 0 if none"/>
        <FIELD NAME="data"        TYPE="text" NOTNULL="false" COMMENT="Details as JSON"/>
        <FIELD NAME="timecreated" TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="userid"      UNIQUE="false" FIELDS="userid"/>
        <INDEX NAME="timecreated" UNIQUE="false" FIELDS="timecreated"/>
        <INDEX NAME="loglevel"    UNIQUE="false" FIELDS="loglevel"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
